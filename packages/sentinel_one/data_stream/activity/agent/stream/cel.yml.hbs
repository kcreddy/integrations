config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if retry_max_attempts}}
resource.retry.max_attempts: {{retry_max_attempts}}
{{/if}}
resource.url: {{url}}
state:
  want_more: false
  api_token: {{api_token}}
  initial_interval: {{initial_interval}}
  batch_size: {{batch_size}}
{{#if site_ids }}
  site_ids: !!str {{site_ids}}
{{/if}}
redact:
  fields:
    - api_token
program: |-
  (
    state.?want_more.orValue(false) ?
      state
    :
      state.with({
        "start_time": state.?cursor.last_create_at.orValue(now - duration(state.initial_interval)),
      })
  ).as(state, state.with(
    request("GET",
      state.url.trim_right("/") + "/web/api/v2.1/activities?" + {
        "limit": [string(state.batch_size)],
        "sortBy": ["createdAt"],
        "sortOrder": ["asc"],
        "createdAt__gte": [string(state.start_time)],
        ?"cursor": state.?end_cursor.value.optMap(v, [v]),
        ?"siteIds": state.?site_ids.optMap(v, [string(v)]),
      }.format_query()
    ).with({
      "Header":{
        "Authorization": ["ApiToken " + string(state.api_token)],
      }
    }).do_request().as(resp, resp.StatusCode == 200 ?
      resp.Body.decode_json().as(body, {
        "events": (
          size(body.data) != 0 ?
            body.data.map(e, {"message": e.encode_json()})
          :
            [{"message": "retry"}]
        ),
        "end_cursor": {
          ?"value": has(body.?pagination.nextCursor) && body.pagination.nextCursor != null ? 
            body.?pagination.nextCursor 
          : 
            optional.none()
        },
        "want_more": has(body.?pagination.nextCursor) && body.pagination.nextCursor != null,
        "cursor": {
          ?"last_create_at": has(body.?pagination.nextCursor) && body.pagination.nextCursor != null ?
            optional.of(timestamp(body.data[size(body.data) - 1].createdAt))
          :
            state.?cursor.last_create_at
        }
      })
    :
      {
        "events": {
          "error": {
            "code": string(resp.StatusCode),
            "id": string(resp.Status),
            "message": "GET " + state.url.trim_right("/") + "/web/api/v2.1/activities: " + (
              size(resp.Body) != 0 ?
                string(resp.Body)
              :
                string(resp.Status) + ' (' + string(resp.StatusCode) + ')'
            ),
          },
        },
        "end_cursor": {},
        "want_more": false,
      }
    )
  ))
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
