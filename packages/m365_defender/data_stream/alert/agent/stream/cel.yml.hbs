config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
auth.oauth2:
  client.id: {{client_id}}
  client.secret: {{client_secret}}
  token_url: {{token_url}}/{{azure_tenant_id}}/oauth2/v2.0/token
  scopes:
{{#each token_scopes as |token_scope|}}
    - {{token_scope}}
{{/each}}
{{#if oauth_endpoint_params}}
  endpoint_params: {{oauth_endpoint_params}}
{{/if}}
state:
  initial_interval: {{initial_interval}}
  batch_size: {{batch_size}}
redact:
  fields: ~
program: |
  state.with(
    // Agent config and state JSON round-trips deliver numeric values as double;
    // cast to int at the boundary so arithmetic (int + double has no overload) works.
    int(state.batch_size).as(batch_size,
    int(state.?skip.orValue(0)).as(skip,
    // On a fresh start (skip=0) compute filter_time from cursor; during pagination reuse page_filter.
    (skip > 0 ?
      state.page_filter
    :
      state.?cursor.last_update_time.orValue(
        (now - duration(state.initial_interval)).format(time_layout.RFC3339)
      )
    ).as(filter_time,
      request(
        "GET",
        state.url.trim_right("/") + "/v1.0/security/alerts_v2?" + {
          "$top": [string(batch_size)],
          "$skip": [string(skip)],
          "$filter": ["lastUpdateDateTime ge " + filter_time],
          "$orderby": ["lastUpdateDateTime asc"],
        }.format_query()
      ){{#if include_unknown_enum_members}}.with({"Header": {"Prefer": ["include-unknown-enum-members"]}}){{/if}}.do_request().as(resp, resp.StatusCode == 200 ?
        bytes(resp.Body).decode_json().as(body,
          (size(body.?value.orValue([])) == batch_size).as(has_more, {
            "events": body.?value.orValue([]).map(e, {"message": e.encode_json()}),
            "cursor": {
              "last_update_time": has_more ?
                // Preserve cursor during pagination; update only on the last page.
                state.?cursor.last_update_time.orValue(filter_time)
              :
                (size(body.?value.orValue([])) > 0 ?
                  // Last page, ordered asc: last item has the highest lastUpdateDateTime.
                  body.value[size(body.value) - 1].lastUpdateDateTime
                :
                  state.?cursor.last_update_time.orValue(filter_time))
            },
            "page_filter": filter_time,
            "skip": has_more ? skip + batch_size : 0,
            "want_more": has_more,
          })
        )
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "GET /v1.0/security/alerts_v2: " + (
                size(resp.Body) != 0 ?
                  string(resp.Body)
                :
                  string(resp.Status) + " (" + string(resp.StatusCode) + ")"
              ),
            },
          },
          "want_more": false,
        }
      )
    )
  )))
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
